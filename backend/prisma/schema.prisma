generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int          @id @default(autoincrement())
  email     String       @unique
  passwordHash String
  name      String?
  submissions Submission[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Submission {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  code      String
  language  String
  source    String?
  reviews   Review[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Review {
  id            Int      @id @default(autoincrement())
  submissionId  Int
  submission    Submission @relation(fields: [submissionId], references: [id])
  aiFeedback    String
  score         Float
  testCasesJson String
  passRate      Float?
  remark        String?
  improvedCode  String?
  explanationEn String?
  explanationHi String?
  createdAt     DateTime @default(now())

  @@index([submissionId])
}
